{
    "outputDirectory": ".",
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/",
            "destination": "/landing.html"
        },
        {
            "source": "/admin",
            "destination": "/index.html?view=dashboard"
        },
        {
            "source": "/r/:slug",
            "destination": "/index.html"
        }
    ]
}